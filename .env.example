# Copy this file to ".env" (it is git-ignored) and change the values.

# Keycloak admin console (http://localhost:8080)
KEYCLOAK_USER=admin
KEYCLOAK_PASSWD=change-me

# SQL Server "sa" password: at least 8 characters with upper case, lower case and a digit or symbol.
# Do not use ";" in it: it is placed inside the connection string.
MSSQL_SA_PASSWORD=Change-me-123

# Optional: Keycloak image tag (default 24.0.1)
# KEYCLOAK_VERSION=24.0.1
